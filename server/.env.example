# singbox-ui server configuration (all values are environment variables).

# Directory that holds the SQLite database and auto-generated TLS material.
SINGBOX_UI_DATA_DIR=./data

# Listen address for the HTTPS panel server.
SINGBOX_UI_ADDR=:8443

# Core backend: "clash" talks to a locally running sing-box (official build)
# via its Clash API; "fake" produces synthetic data for local development.
SINGBOX_UI_CORE=clash

# Base URL of the sing-box Clash API (only used when SINGBOX_UI_CORE=clash).
SINGBOX_UI_CLASH_API=http://127.0.0.1:9090

# Optional bearer secret for the Clash API (leave empty if none is set).
# SINGBOX_UI_CLASH_SECRET=

# Path of the sing-box config file. The panel only READS it (inbound
# comparison + first-run import); it never writes to it.
# SINGBOX_UI_SINGBOX_CONFIG=/etc/sing-box/config.json

# TLS certificate / key paths. If both are unset, a self-signed certificate
# for localhost/127.0.0.1 is generated into SINGBOX_UI_DATA_DIR on first start
# and the panel is still served over HTTPS.
# SINGBOX_UI_TLS_CERT=/path/to/cert.pem
# SINGBOX_UI_TLS_KEY=/path/to/key.pem
